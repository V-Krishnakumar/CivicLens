# CivicLens Environment Configuration

# Directory paths (default for Docker is /app/data, local dev can set relative or absolute path)
CIVICLENS_DATA_DIR=./data

# Maximum file upload size in bytes (default: 26214400 = 25 MB)
MAX_UPLOAD_BYTES=26214400

# Local Ollama inference server
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model tag
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
